import { Theme } from "../theme.slint";

export component ProgressBar {
    in property <float> progress: 0.0;
    in property <string> current-time: "0:00";
    in property <string> total-time: "0:00";
    
    callback seek(float);

    height: 16px;
    width: 100%;

    HorizontalLayout {
        spacing: Theme.spacing-sm;
        
        Text {
            text: root.current-time;
            color: Theme.text-secondary;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }

        track := Rectangle {
            vertical-stretch: 1;
            height: 4px;
            border-radius: 2px;
            background: Theme.borders;
            y: (parent.height - self.height) / 2;

            Rectangle {
                width: parent.width * root.progress;
                height: 100%;
                border-radius: 2px;
                background: Theme.primary; // Or gradient, using primary for now
            }

            if touch.has-hover : Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: Theme.accent;
                x: parent.width * root.progress - 6px;
                y: (parent.height - self.height) / 2;
            }

            touch := TouchArea {
                width: 100%;
                height: 10px;
                y: -3px;
                clicked => {
                    root.seek(self.mouse-x / self.width);
                }
            }
        }

        Text {
            text: root.total-time;
            color: Theme.text-secondary;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
    }
}
